<Window x:Class="MYRP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MYRP"
        mc:Ignorable="d"
        Title="MyRPG" Height="450" Width="800">
    <Grid Margin="57,120,200,9">
        <Button Content="Press" Background="#FF0800FF" FontSize="32" Margin="57,120,185,9"/>
        <Label Content="Enter Player name" HorizontalAlignment="Left" Margin="146,-74,0,0" VerticalAlignment="Top" FontSize="32" Width="382"/>
        <TextBox TextWrapping="Wrap" Text="Text box" Width="150" Height="200" HorizontalAlignment="Right" FontSize="32" TextChanged="TextBox_TextChanged"/>


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
    </Grid>
</Window>
